diff --git a/tests/Feature/Http/CriticalInvariantsEvaluationTest.php b/tests/Feature/Http/CriticalInvariantsEvaluationTest.php
new file mode 100644
index 0000000..ccf9a6e
--- /dev/null
+++ b/tests/Feature/Http/CriticalInvariantsEvaluationTest.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace Tests\Feature\Http;
+
+use STS\Models\Passenger;
+use STS\Models\Trip;
+use STS\Models\User;
+use Tests\TestCase;
+
+class CriticalInvariantsEvaluationTest extends TestCase
+{
+    public function test_unrelated_user_cannot_cancel_accepted_passenger_but_owner_can(): void
+    {
+        $owner = User::factory()->create();
+        $passenger = User::factory()->create();
+        $stranger = User::factory()->create();
+        $trip = Trip::factory()->create(['user_id' => $owner->id]);
+        Passenger::factory()->aceptado()->create(['trip_id' => $trip->id, 'user_id' => $passenger->id]);
+
+        $this->actingAs($stranger, 'api')
+            ->postJson("/api/trips/{$trip->id}/requests/{$passenger->id}/cancel")
+            ->assertUnprocessable();
+        $this->assertSame(Passenger::STATE_ACCEPTED, Passenger::query()->first()->request_state);
+
+        $this->actingAs($owner, 'api')
+            ->postJson("/api/trips/{$trip->id}/requests/{$passenger->id}/cancel")
+            ->assertOk();
+        $this->assertSame(Passenger::STATE_CANCELED, Passenger::query()->first()->request_state);
+    }
+
+    public function test_public_registration_ignores_server_owned_flags(): void
+    {
+        $email = 'critical-invariants-'.uniqid().'@example.com';
+        $this->postJson('/api/users', [
+            'name' => 'Untrusted Registration', 'email' => $email,
+            'password' => 'password', 'password_confirmation' => 'password',
+            'is_admin' => true, 'active' => true, 'identity_validated' => true,
+            'driver_is_verified' => true,
+        ])->assertOk();
+
+        $user = User::query()->where('email', $email)->firstOrFail();
+        $this->assertFalse((bool) $user->is_admin);
+        $this->assertFalse((bool) $user->active);
+        $this->assertFalse((bool) $user->identity_validated);
+        $this->assertFalse((bool) $user->driver_is_verified);
+    }
+
+    public function test_autoaccept_keeps_second_request_pending_when_capacity_is_full(): void
+    {
+        $owner = User::factory()->create(['autoaccept_requests' => true, 'identity_validated' => true]);
+        $trip = Trip::factory()->create(['user_id' => $owner->id, 'total_seats' => 1]);
+        $first = User::factory()->create(['identity_validated' => true]);
+        $second = User::factory()->create(['identity_validated' => true]);
+
+        $this->actingAs($first, 'api')->postJson("/api/trips/{$trip->id}/requests")->assertOk();
+        $this->actingAs($second, 'api')->postJson("/api/trips/{$trip->id}/requests")->assertOk();
+
+        $this->assertSame(1, Passenger::query()->where('trip_id', $trip->id)
+            ->where('request_state', Passenger::STATE_ACCEPTED)->count());
+        $this->assertSame(1, Passenger::query()->where('trip_id', $trip->id)
+            ->where('request_state', Passenger::STATE_PENDING)->count());
+    }
+}
